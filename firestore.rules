rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // GLOBAL SAFETY NET - Nega tudo por padrão
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // HELPERS GLOBAIS
    // ═══════════════════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ═══════════════════════════════════════════════════════════════
    // FASE 1: RBAC VIA CUSTOM CLAIMS (request.auth.token)
    // NÃO confia em documentos do Firestore para autorização.
    // ═══════════════════════════════════════════════════════════════

    function hasRole(expectedRole) {
      return isSignedIn() && request.auth.token.role == expectedRole;
    }

    function hasAnyRole(expectedRoles) {
      return isSignedIn() && expectedRoles.hasAny([request.auth.token.role]);
    }

    function hasPermission(permission) {
      return isSignedIn() && request.auth.token.permissoes.hasAny([permission]);
    }

    function hasAnyPermission(permissions) {
      return isSignedIn() && request.auth.token.permissoes.hasAny(permissions);
    }

    function userEmpresaId() {
      return request.auth.token.empresaId;
    }

    function sameEmpresa(resourceEmpresaId) {
      return isSignedIn() && userEmpresaId() == resourceEmpresaId;
    }

    // ═══════════════════════════════════════════════════════════════
    // VALIDAÇÕES DE SCHEMA
    // ═══════════════════════════════════════════════════════════════

    function isValidDebtor(data) {
      return data.keys().hasOnly(['name', 'phone', 'amount', 'dueDate', 'daysOverdue', 'description', 'status', 'tone', 'customMessage'])
          && data.name is string && data.name.size() <= 150
          && data.phone is string && data.phone.size() <= 30
          && data.amount is number && data.amount >= 0
          && data.dueDate is string && data.dueDate.size() <= 20
          && data.daysOverdue is number
          && data.description is string && data.description.size() <= 500
          && data.status in ['pending', 'notified', 'negotiating', 'paid']
          && data.tone in ['friendly', 'formal', 'urgent', 'negotiation']
          && (!data.keys().hasAll(['customMessage']) || data.customMessage is string && data.customMessage.size() <= 5000);
    }

    function isValidConfig(data) {
      return data.keys().hasOnly([
            'companyName', 'customSignature', 'paymentMethods', 'pixKey', 'securityPinHash',
            'promptFriendly', 'promptFormal', 'promptUrgent', 'promptNegotiation',
            'templateFriendly', 'templateFormal', 'templateUrgent', 'templateNegotiation'
          ])
          && data.companyName is string && data.companyName.size() <= 100
          && data.customSignature is string && data.customSignature.size() <= 500
          && data.paymentMethods is string && data.paymentMethods.size() <= 500
          && (!data.keys().hasAll(['pixKey']) || data.pixKey is string && data.pixKey.size() <= 150)
          && (!data.keys().hasAll(['securityPinHash']) || data.securityPinHash is string)
          && (!data.keys().hasAll(['promptFriendly']) || data.promptFriendly is string && data.promptFriendly.size() <= 1000)
          && (!data.keys().hasAll(['promptFormal']) || data.promptFormal is string && data.promptFormal.size() <= 1000)
          && (!data.keys().hasAll(['promptUrgent']) || data.promptUrgent is string && data.promptUrgent.size() <= 1000)
          && (!data.keys().hasAll(['promptNegotiation']) || data.promptNegotiation is string && data.promptNegotiation.size() <= 1000)
          && (!data.keys().hasAll(['templateFriendly']) || data.templateFriendly is string && data.templateFriendly.size() <= 2000)
          && (!data.keys().hasAll(['templateFormal']) || data.templateFormal is string && data.templateFormal.size() <= 2000)
          && (!data.keys().hasAll(['templateUrgent']) || data.templateUrgent is string && data.templateUrgent.size() <= 2000)
          && (!data.keys().hasAll(['templateNegotiation']) || data.templateNegotiation is string && data.templateNegotiation.size() <= 2000)
          // FASE 6: securityPin NÃO é permitido - apenas securityPinHash
          && !data.keys().hasAny(['securityPin']);
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['nome', 'email', 'role', 'permissoes', 'empresaId'])
          && data.nome is string && data.nome.size() <= 150
          && data.email is string && data.email.size() <= 150
          && data.role in ['Administrador', 'Financeiro', 'Operador', 'Supervisor', 'Auditor']
          && data.permissoes is list
          && data.permissoes.hasOnly(['Visualizar', 'Criar', 'Editar', 'Excluir', 'Aprovar'])
          && data.empresaId is string && data.empresaId.size() <= 128;
    }

    // ═══════════════════════════════════════════════════════════════
    // USUÁRIOS (RBAC)
    // ═══════════════════════════════════════════════════════════════
    match /usuarios/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid
          || hasPermission('Visualizar'));

      // FASE 1: Apenas Administradores com Custom Claim role
      allow create, update: if hasRole('Administrador') && isValidUser(request.resource.data);
      allow delete: if hasRole('Administrador');
    }

    // ═══════════════════════════════════════════════════════════════
    // DEBTORS (subcoleção por usuário)
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      match /debtors/{debtorId} {
        allow read: if isOwner(userId) && hasPermission('Visualizar');

        allow create: if isOwner(userId)
                      && isValidId(debtorId)
                      && hasPermission('Criar')
                      && (request.resource.data.status == 'paid' ? hasPermission('Aprovar') : true)
                      && isValidDebtor(request.resource.data)
                      && request.resource.data.keys().hasAll(['name', 'phone', 'amount', 'dueDate', 'daysOverdue', 'description', 'status', 'tone']);

        allow update: if isOwner(userId)
                      && isValidId(debtorId)
                      && (
                        (request.resource.data.status == 'paid' && request.resource.data.status != resource.data.status)
                        ? hasPermission('Aprovar')
                        : hasPermission('Editar')
                      )
                      && isValidDebtor(request.resource.data);

        allow delete: if isOwner(userId) && hasPermission('Excluir');
      }

      match /config/{configId} {
        allow read: if isOwner(userId) && hasPermission('Visualizar');

        allow create, update: if isOwner(userId)
                              && isValidId(configId)
                              && hasPermission('Editar')
                              && isValidConfig(request.resource.data);

        allow delete: if isOwner(userId) && hasPermission('Editar');
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // FASE 2: ISOLAMENTO TOTAL DO MÓDULO FINANCEIRO
    // ═══════════════════════════════════════════════════════════════
    //
    // Regra: NENHUMA OPERAÇÃO FINANCEIRA PODE SER ESCRITA DIRETAMENTE.
    // Apenas leitura para usuários autorizados via Custom Claims.
    // Toda gravação via Firebase Admin SDK (backend).
    //

    // --- MOVIMENTO DE CAIXA ---
    match /financeiro/caixa/{collectionId}/{documentId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Backup compatibilidade com coleção antiga
    match /financeiro/caixa/movimentos/{movimentoId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // --- DUPLICATAS ---
    match /financeiro/duplicatas/{duplicataId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // --- PAGAMENTOS ---
    match /financeiro/pagamentos/{pagamentoId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // --- LANÇAMENTOS FINANCEIROS ---
    match /financeiro/lancamentos/{lancamentoId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // --- NOTAS FISCAIS ---
    match /financeiro/notasFiscais/{notaId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // FASE 3: AUDITORIA IMUTÁVEL
    // ═══════════════════════════════════════════════════════════════
    match /auditoria/{logId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow create: if false;  // Apenas via Admin SDK
      allow update: if false;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // COMPATIBILIDADE RETROATIVA: coleções antigas
    // ═══════════════════════════════════════════════════════════════

    match /caixa/{movimentoId} {
      allow read: if hasPermission('Visualizar') && sameEmpresa(resource.data.empresaId);
      allow write: if false;
    }

    match /duplicatas/{duplicataId} {
      allow read: if hasPermission('Visualizar');
      allow write: if false;
    }
  }
}
